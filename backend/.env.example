PORT=5001
DATABASE_URL=postgresql://user:password@localhost:5432/safezone
# Long random strings. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
ENCRYPTION_KEY=
FRONTEND_URL=http://localhost:5173
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5001/api/calendar/google/callback

# Email (leave SMTP_HOST empty to save emails as HTML files in backend/mail-outbox instead)
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=you@gmail.com, SMTP_PASS=<16-character app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Safe Zone <no-reply@safezone.local>
APP_TIMEZONE=Europe/Vilnius
NOTIFY_INTERVAL_MINUTES=5

# Security
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=24
REQUIRE_2FA_FOR_MANAGERS=true
PRIVACY_POLICY_VERSION=1.0

# Video calls: rooms are created on this Jitsi server (self-hosted Jitsi works too). Google Meet is used instead
# when the organizer has connected Google Calendar.
JITSI_BASE_URL=https://meet.jit.si
