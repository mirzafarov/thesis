// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String              @id @default(uuid())
  email             String              @unique
  passwordHash      String
  firstName         String
  lastName          String
  phone             String?
  emailVerifiedAt   DateTime?           // set when the user clicks the link in the confirmation email
  consentAt         DateTime?           // when the user accepted the privacy policy / GDPR rules
  consentVersion    String?             // which version of the rules they accepted
  timeZone          String?             // IANA time zone, e.g. "Europe/Vilnius" (taken from the browser)
  workdayStart      Int                 @default(9)  // working hours in the user's own time zone
  workdayEnd        Int                 @default(17)
  totpSecret        String?             // two-factor secret (encrypted); set once 2FA is enabled
  totpPendingSecret String?             // secret shown during setup, before the first code is confirmed
  totpEnabledAt     DateTime?
  totpLastStep      Int?                // last accepted 30-second step, so a code cannot be reused
  blockedAt         DateTime?           // blocked by an administrator: cannot log in
  blockedReason     String?
  failedLoginCount  Int                 @default(0) // wrong passwords in a row (reset after a successful login)
  lockedUntil       DateTime?           // temporary lock after too many wrong passwords
  systemRole        SystemRole          @default(USER) // e.g., ADMIN, USER
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  projectMemberships ProjectMembership[]
  meetingsOrganized  Meeting[]          @relation("MeetingOrganizer")
  meetingParticipations MeetingParticipant[]
  calendarAccounts   CalendarAccount[]
  aiDrafts           AiDraft[]
  pollVotes          PollVote[]
  auditLogs          AuditLog[]
  responsibleFor     Activity[]          @relation("ActivityResponsible")
  tokens             UserToken[]
  notifications      NotificationLog[]
  sessions           Session[]
  recoveryCodes      RecoveryCode[]
}

// A logged-in device. Every login token points to a session, so a session can be ended remotely
// and expires after a period of inactivity.
model Session {
  id         String    @id @default(uuid())
  userId     String
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  mfaSetupRequired Boolean @default(false) // logged in without 2FA although the role requires it

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// System-wide settings changed by administrators (security policy etc.). One row per setting.
model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?  // id of the administrator who changed it
}

// One-time backup codes for two-factor login (only hashes are stored).
model RecoveryCode {
  id        String    @id @default(uuid())
  userId    String
  codeHash  String
  usedAt    DateTime?

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// One-time links sent by email (password reset, email confirmation).
// Only a SHA-256 hash of the token is stored, so a database leak does not expose usable links.
model UserToken {
  id        String         @id @default(uuid())
  userId    String
  purpose   TokenPurpose
  tokenHash String         @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime       @default(now())

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum TokenPurpose {
  PASSWORD_RESET
  EMAIL_VERIFICATION
}

// Record of notification emails already sent, so nobody gets the same reminder twice.
model NotificationLog {
  id        String   @id @default(uuid())
  userId    String
  type      String   // e.g. MEETING_REMINDER_24H, ACTIVITY_DELAYED
  refId     String   // what it is about, e.g. a meeting id
  sentAt    DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, refId])
}

enum SystemRole {
  ADMIN
  USER
}

model Project {
  id          String              @id @default(uuid())
  name        String
  description String?
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  members     ProjectMembership[]
  phases      Phase[]
  activities  Activity[]
  meetings    Meeting[]
}

// Main phase / milestone of a project (Project -> Phase -> Activity -> Meeting), shown on the Gantt chart.
model Phase {
  id          String     @id @default(uuid())
  projectId   String
  name        String
  startDate   DateTime
  endDate     DateTime
  isMilestone Boolean    @default(false) // a single key date rather than a span
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  activities  Activity[]
}

model ProjectMembership {
  id        String   @id @default(uuid())
  userId    String
  projectId String
  role      ProjectRole @default(OBSERVER) // e.g., MANAGER, EMPLOYEE, OBSERVER
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
}

enum ProjectRole {
  MANAGER
  EMPLOYEE
  OBSERVER
}

model Activity {
  id          String    @id @default(uuid())
  projectId   String
  phaseId     String?
  responsibleId String?
  title       String
  description String?
  startDate   DateTime?
  endDate     DateTime?
  status      ActivityStatus @default(PENDING)
  isCritical  Boolean   @default(false) // delays on critical activities trigger notifications
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phase       Phase?    @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  responsible User?     @relation("ActivityResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)
  meetings    Meeting[]
}

enum ActivityStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  DELAYED
}

model Meeting {
  id          String    @id @default(uuid())
  projectId   String
  activityId  String?
  organizerId String
  title       String
  description String?
  startDate   DateTime? // null if still in polling
  endDate     DateTime?
  durationMin Int
  category    MeetingCategory @default(OTHER) // used to filter reports, e.g. only strategic meetings
  status      MeetingStatus @default(DRAFT)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  activity    Activity? @relation(fields: [activityId], references: [id], onDelete: SetNull)
  organizer   User      @relation("MeetingOrganizer", fields: [organizerId], references: [id])
  
  participants MeetingParticipant[]
  polls        MeetingPoll[]
  aiDrafts     AiDraft[]
}

enum MeetingCategory {
  STRATEGIC
  PLANNING
  REVIEW
  STATUS
  OTHER
}

enum MeetingStatus {
  DRAFT
  AVAILABILITY_SEARCH
  SLOT_SUGGESTED
  POLL_CREATED
  VOTING_IN_PROGRESS
  CONFIRMED
  CALENDAR_SYNCHRONIZED
  IN_PROGRESS
  COMPLETED
  RESCHEDULED
  CANCELLED
}

model MeetingParticipant {
  id        String   @id @default(uuid())
  meetingId String
  userId    String
  status    ParticipantStatus @default(INVITED)
  
  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([meetingId, userId])
}

enum ParticipantStatus {
  INVITED
  ACCEPTED
  DECLINED
  TENTATIVE
}

model CalendarAccount {
  id           String   @id @default(uuid())
  userId       String
  provider     String   // "google" or "outlook"
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  email        String
  
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MeetingPoll {
  id          String   @id @default(uuid())
  meetingId   String
  startTime   DateTime
  endTime     DateTime
  
  meeting     Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  votes       PollVote[]
}

model PollVote {
  id          String   @id @default(uuid())
  pollId      String
  userId      String
  vote        VoteType // YES, NO, IF_NECESSARY
  
  poll        MeetingPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId])
}

enum VoteType {
  YES
  NO
  IF_NECESSARY
}

model AiDraft {
  id        String   @id @default(uuid())
  meetingId String
  userId    String
  draftType DraftType // INVITATION, AGENDA, REMINDER, SUMMARY
  content   String
  createdAt DateTime @default(now())
  
  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum DraftType {
  INVITATION
  AGENDA
  REMINDER
  SUMMARY
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  projectId String?  // set for actions inside a project (project audit trail)
  action    String
  ipAddress String?
  details   String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
}

